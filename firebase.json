{
  "hosting": {
    "site": "ecosistema-iwitown",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "*.md",
      "herramientas/**",
      "**/*.txt"
    ],
    "rewrites": [
      {
        "source": "/api/contacto",
        "function": { "functionId": "landingContacto", "region": "us-central1" }
      },
      {
        "source": "/api/horas",
        "function": { "functionId": "landingHoras", "region": "us-central1" }
      },
      {
        "source": "/api/agendar",
        "function": { "functionId": "landingAgendar", "region": "us-central1" }
      },
      {
        "source": "/api/sala",
        "function": { "functionId": "landingSala", "region": "us-central1" }
      },
      {
        "//": "Una ruta por vista. NO se usa un comodin /** a proposito: taparia los 404 y una imagen que falte devolveria la pagina entera con codigo 200. Se listan las ocho vistas; el inicio es la raiz. Van DESPUES de las de /api/.",
        "source": "/@(marca|problema|solucion|ecosistema|acp|consultoria|contacto|conversemos)",
        "destination": "/index.html"
      },
      {
        "source": "/@(marca|problema|solucion|ecosistema|acp|consultoria|contacto|conversemos)/",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|webp|svg|ico|mp4|mp3|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
        ]
      }
    ]
  }
}
